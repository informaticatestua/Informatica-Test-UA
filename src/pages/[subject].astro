<script is:inline>
(function () {
    "use strict";
    function syncMobileStats() {
        var sp  = document.getElementById("stats-panel");
        var row = document.getElementById("quiz-mobile-stats");
        if (!sp || !row) return;
        var visible = !sp.classList.contains("hidden");
        row.classList.toggle("hidden", !visible);
        if (visible) {
            var tp = document.getElementById("total-preguntas");
            var ct = document.getElementById("contador");
            var mtp = document.getElementById("mobile-total-preguntas");
            var mct = document.getElementById("mobile-contador");
            if (tp && mtp) mtp.innerHTML = tp.innerHTML;
            if (ct && mct) mct.innerHTML = ct.innerHTML;
        }
    }
    function init() {
        var sp = document.getElementById("stats-panel");
        if (!sp) return;
        var obs = new MutationObserver(syncMobileStats);
        obs.observe(sp, { subtree: true, childList: true, attributes: true, attributeFilter: ["class"] });
    }
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
    } else {
        init();
    }
})();
</script>
