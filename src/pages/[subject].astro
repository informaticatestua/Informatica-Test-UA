---
import BaseLayout from '../layouts/BaseLayout.astro';

const { subject } = Astro.params;
const subjectTitle = subject ? subject.toUpperCase().replace(/-/g, ' ') : 'Test';
---

<BaseLayout title={`${subjectTitle} • Tests UA`}>
	<div id="main-container" class="w-full max-w-3xl mx-auto px-3 sm:px-6 pt-5 sm:pt-8 pb-6">
		<h1 class="sr-only">{subjectTitle} · Test de práctica</h1>

		<!-- Navegación contextual discreta -->
		<div class="flex items-center justify-between gap-3 mb-3 px-1">
			<a href="/" class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-medium text-text-muted hover:text-text-main no-underline transition-colors">
				<span class="material-icons mi-sm" aria-hidden="true">arrow_back</span>
				<span>Asignaturas</span>
			</a>
			<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[0.72rem] font-semibold tracking-wide bg-surface border border-border-subtle text-text-muted">
				{subjectTitle}
			</span>
		</div>

		<div id="app" class="relative w-full text-center bg-surface shadow-card rounded-2xl px-4 sm:px-9 pt-6 pb-7 box-border border border-border-subtle overflow-hidden">

			<!-- Barra de progreso -->
			<div id="quiz-progress" class="quiz-progress" role="progressbar" aria-label="Progreso del test" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
				<div id="quiz-progress-bar" class="quiz-progress-bar"></div>
			</div>

			<!-- Barra superior: posición actual + acciones -->
			<div id="quiz-toolbar" class="quiz-toolbar">
				<span id="quiz-progress-label" class="quiz-progress-label" aria-live="polite"></span>
				<div class="quiz-toolbar-actions">
					<button id="explicar-ia-btn" class="quiz-tool-btn quiz-tool-btn--ai" title="Explicar con IA" aria-label="Explicar con IA" disabled>
						<span class="material-icons mi-sm" aria-hidden="true">auto_awesome</span>
						<span class="hidden sm:inline text-xs font-semibold">Explicar</span>
					</button>
					<button id="report-btn" class="quiz-tool-btn quiz-tool-btn--danger" title="Reportar un error en esta pregunta" aria-label="Reportar un error en esta pregunta">
						<span class="material-icons mi-sm" aria-hidden="true">flag</span>
					</button>
					<button id="copyButton" class="quiz-tool-btn" title="Copiar pregunta" aria-label="Copiar pregunta">
						<span class="material-icons mi-sm" aria-hidden="true">content_copy</span>
						<span id="copyText" class="sr-only">Copiar</span>
					</button>
				</div>
			</div>

			<!-- ── Selector de modo ─────────────────────────────────────────── -->
			<section id="mode-selector" class="hidden text-left py-2">
				<header class="mode-selector-header">
					<p class="mode-selector-eyebrow">Asignatura</p>
					<h2 id="mode-selector-title" class="mode-selector-title"></h2>
					<p id="mode-selector-subtitle" class="mode-selector-subtitle">Elige cómo quieres preparar esta sesión</p>
				</header>
				<div class="mode-cards">
					<button type="button" id="mode-card-practice" class="mode-card mode-card--primary">
						<span class="mode-card-icon"><span class="material-icons" aria-hidden="true">school</span></span>
						<span class="mode-card-body">
							<span class="mode-card-title">Practicar</span>
							<span class="mode-card-desc">Estudio libre con corrección inmediata tras cada pregunta</span>
						</span>
						<span class="mode-card-arrow material-icons" aria-hidden="true">arrow_forward</span>
					</button>
					<button type="button" id="mode-card-exam" class="mode-card mode-card--exam">
						<span class="mode-card-icon"><span class="material-icons" aria-hidden="true">timer</span></span>
						<span class="mode-card-body">
							<span class="mode-card-title">Modo examen</span>
							<span class="mode-card-desc">Simulacro cronometrado con penalización y nota final</span>
						</span>
						<span class="mode-card-arrow material-icons" aria-hidden="true">arrow_forward</span>
					</button>
					<button type="button" id="mode-card-review" class="mode-card mode-card--review">
						<span class="mode-card-icon"><span class="material-icons" aria-hidden="true">refresh</span></span>
						<span class="mode-card-body">
							<span class="mode-card-title">Repasar fallos <span id="mode-card-review-count" class="mode-card-count hidden"></span></span>
							<span id="mode-card-review-desc" class="mode-card-desc">Vuelve solo sobre lo que fallaste</span>
						</span>
						<span class="mode-card-arrow material-icons" aria-hidden="true">arrow_forward</span>
					</button>
					<button type="button" id="mode-card-aigen" class="mode-card mode-card--aigen">
						<span class="mode-card-icon"><span class="material-icons" aria-hidden="true">auto_awesome</span></span>
						<span class="mode-card-body">
							<span class="mode-card-title">Quiz con IA</span>
							<span class="mode-card-desc">Genera preguntas nuevas al instante sobre el temario</span>
						</span>
						<span class="mode-card-arrow material-icons" aria-hidden="true">arrow_forward</span>
					</button>
				</div>
			</section>

			<div id="pregunta" class="quiz-question text-left"></div>

			<div id="report-warning" class="report-warning hidden" role="status" aria-live="polite" aria-atomic="true"></div>

			<form id="opciones" class="text-left flex flex-col mt-3 w-full gap-2.5 sm:gap-3"></form>

			<div id="resultado" class="mt-3 font-semibold text-center min-h-[16px]"></div>

			<!-- ── Resultados de sesión de práctica ─────────────────────────── -->
			<section id="session-results" class="hidden text-left">
				<div class="results-hero">
					<div class="results-badge">
						<span class="material-icons" aria-hidden="true">emoji_events</span>
						<span>Sesión completada</span>
					</div>
					<h3 id="results-title" class="results-title">Buen trabajo</h3>
					<p id="results-subtitle" class="results-subtitle">Has terminado este módulo.</p>
				</div>

				<div class="results-grid">
					<article class="results-stat-card">
						<span class="results-stat-label">Aciertos</span>
						<strong id="results-correct" class="results-stat-value text-emerald-600 dark:text-emerald-400 tabular">0</strong>
					</article>
					<article class="results-stat-card">
						<span class="results-stat-label">Fallos</span>
						<strong id="results-incorrect" class="results-stat-value text-red-600 dark:text-red-400 tabular">0</strong>
					</article>
					<article class="results-stat-card">
						<span class="results-stat-label">Precisión</span>
						<strong id="results-accuracy" class="results-stat-value tabular">0%</strong>
					</article>
				</div>

				<div id="results-summary" class="results-summary"></div>

				<div class="results-actions">
					<button id="results-restart-btn" class="btn-primary w-full sm:w-auto">Repetir módulo</button>
					<button id="results-review-btn" class="btn-secondary w-full sm:w-auto">Repasar fallos</button>
					<button id="results-resumen-btn" class="btn w-full sm:w-auto">Ver resumen</button>
				</div>
			</section>

			<!-- ── Resultados del modo examen ───────────────────────────────── -->
			<section id="exam-results" class="hidden text-left">
				<div class="results-hero">
					<div class="results-badge results-badge--exam">
						<span class="material-icons" aria-hidden="true">timer</span>
						<span>Examen finalizado</span>
					</div>
					<h3 id="exam-results-title" class="results-title">Resultados del examen</h3>
					<p id="exam-results-subtitle" class="results-subtitle"></p>
				</div>

				<div class="results-grid results-grid--exam">
					<article class="results-stat-card">
						<span class="results-stat-label">Nota</span>
						<strong id="exam-score" class="results-stat-value tabular">0</strong>
					</article>
					<article class="results-stat-card">
						<span class="results-stat-label">Tiempo</span>
						<strong id="exam-time" class="results-stat-value tabular">0:00</strong>
					</article>
					<article class="results-stat-card">
						<span class="results-stat-label">Aciertos</span>
						<strong id="exam-correct" class="results-stat-value text-emerald-600 dark:text-emerald-400 tabular">0</strong>
					</article>
					<article class="results-stat-card">
						<span class="results-stat-label">Fallos</span>
						<strong id="exam-wrong" class="results-stat-value text-red-600 dark:text-red-400 tabular">0</strong>
					</article>
					<article class="results-stat-card">
						<span class="results-stat-label">En blanco</span>
						<strong id="exam-blank" class="results-stat-value tabular">0</strong>
					</article>
				</div>

				<div class="flex items-center gap-3 mb-4 mt-2">
					<div class="flex-1 h-px bg-border-subtle"></div>
					<span class="text-[0.7rem] text-text-muted font-semibold uppercase tracking-wider">Desglose pregunta a pregunta</span>
					<div class="flex-1 h-px bg-border-subtle"></div>
				</div>
				<div id="exam-breakdown" class="space-y-3 mb-6"></div>

				<div class="results-actions">
					<button id="exam-exit-btn" class="btn-primary w-full sm:w-auto">Volver al modo test</button>
					<button id="exam-retry-btn" class="btn-secondary w-full sm:w-auto">Repetir examen</button>
				</div>
			</section>

			<!-- ── Barra inferior de acciones del quiz ──────────────────────── -->
			<div id="action-buttons-container" class="quiz-actions">
				<div id="quiz-mobile-stats" class="hidden flex items-center justify-center flex-wrap gap-1.5 pb-3 border-b border-border-subtle mb-1">
					<span id="mobile-total-preguntas" class="inline-flex items-center gap-1.5 flex-wrap justify-center"></span>
					<span id="mobile-contador" class="inline-flex items-center gap-1.5 flex-wrap justify-center"></span>
				</div>
				<div class="quiz-actions-primary">
					<button id="volver-pregunta" class="quiz-nav-btn hidden" aria-label="Pregunta anterior">
						<span class="material-icons" aria-hidden="true">chevron_left</span>
						<span class="quiz-nav-btn-label">Anterior</span>
					</button>
					<button id="verificar" class="hidden quiz-verify-btn" disabled>Verificar / Continuar</button>
					<button id="resumenBtn" class="quiz-nav-btn w-full sm:w-auto" aria-label="Ver resumen de la asignatura">
						<span class="material-icons" aria-hidden="true">summarize</span>
						<span class="quiz-nav-btn-label">Resumen</span>
					</button>
				</div>
			</div>
		</div>
	</div>

	<!-- Triggers ocultos requeridos por ai-generate.js y bindExamButtons -->
	<div class="hidden" aria-hidden="true">
		<button id="aigen-open-btn" type="button"></button>
		<button id="exam-open-btn" type="button"></button>
	</div>

	<!-- Fuente de stats oculta visualmente y sincronizada en #quiz-mobile-stats -->
	<div id="stats-panel" class="hidden" aria-hidden="true">
		<span id="total-preguntas"></span>
		<span id="contador"></span>
	</div>

	<!-- Cronómetro del modo examen -->
	<div id="exam-timer-chip" class="hidden fixed top-[76px] right-3 sm:right-5 z-40 flex items-center gap-2 bg-amber-600 text-white text-xs sm:text-sm px-3.5 py-2 rounded-full shadow-elevated font-semibold tabular-nums">
		<span class="material-icons text-[16px]" aria-hidden="true">timer</span>
		<span id="exam-timer-label">0:00</span>
	</div>

	<!-- Botón Finalizar examen (móvil) -->
	<button id="exam-finish-mobile" class="hidden fixed z-40 flex items-center gap-1.5 bg-surface border border-amber-500/50 text-amber-700 dark:text-amber-300 text-xs px-3 py-2 rounded-full shadow-elevated font-semibold" style="top: 120px; right: 12px;" aria-label="Finalizar examen">
		<span class="material-icons" style="font-size:1rem;" aria-hidden="true">send</span>
		<span>Finalizar</span>
	</button>

	<!-- Panel de navegación del examen (desktop) -->
	<div id="exam-nav-panel" class="hidden fixed right-4 z-40 w-[204px] max-h-[calc(100vh-140px)] overflow-y-auto bg-surface border border-border-subtle rounded-2xl shadow-elevated" style="top: 122px;">
		<div class="px-3.5 py-2.5 border-b border-border-subtle flex items-center gap-1.5">
			<span class="material-icons text-amber-500" style="font-size:0.95rem;" aria-hidden="true">grid_view</span>
			<h4 class="text-[0.68rem] font-bold uppercase tracking-wider text-text-muted m-0">Navegación</h4>
		</div>
		<div class="p-3">
			<div id="exam-nav-grid" class="grid grid-cols-5 gap-1.5 mb-3"></div>
			<div class="text-[0.72rem] text-text-muted text-center mb-2.5 flex items-center justify-center gap-1.5 tabular">
				<span class="inline-block w-2.5 h-2.5 rounded-sm bg-amber-500/60 flex-shrink-0"></span>
				<span><span id="exam-nav-answered">0</span> / <span id="exam-nav-total">0</span> respondidas</span>
			</div>
			<button id="exam-finish-btn" class="w-full py-2 rounded-lg text-xs font-semibold text-white bg-amber-600 hover:bg-amber-700 transition-colors cursor-pointer border-none flex items-center justify-center gap-1.5">
				<span class="material-icons" style="font-size:0.95rem;" aria-hidden="true">send</span>
				Finalizar examen
			</button>
		</div>
	</div>

	<!-- ─── AI Generate Modal ─────────────────────────────────────────────── -->
	<div id="aigen-overlay" class="hidden fixed inset-0 z-[300] bg-[#0b0f19]/60 backdrop-blur-sm"></div>
	<div id="aigen-modal" class="hidden fixed inset-0 z-[301] flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="aigen-title">
		<div class="aigen-modal-box w-full max-w-md bg-surface rounded-2xl shadow-elevated border border-border-subtle overflow-hidden">
			<div class="p-6">
				<div class="flex items-start justify-between mb-5">
					<div class="flex items-center gap-3">
						<div class="flex items-center justify-center w-10 h-10 rounded-xl bg-accent/10 text-accent-text flex-shrink-0">
							<span class="material-icons" aria-hidden="true">psychology</span>
						</div>
						<div>
							<h3 id="aigen-title" class="font-heading font-bold text-text-main text-base m-0 leading-tight">Generar quiz con IA</h3>
							<p class="text-text-muted text-xs mt-0.5 m-0">Preguntas nuevas sobre esta asignatura</p>
						</div>
					</div>
					<button id="aigen-close" class="p-1.5 text-text-muted hover:text-text-main rounded-lg hover:bg-surface-hover transition-colors cursor-pointer border-none bg-transparent flex-shrink-0" aria-label="Cerrar">
						<span class="material-icons mi-md">close</span>
					</button>
				</div>

				<div id="aigen-config">
					<div class="flex items-center gap-2 p-3 mb-5 bg-surface-hover rounded-xl border border-border-subtle text-sm">
						<span class="material-icons text-accent-text" style="font-size:1rem;">auto_awesome</span>
						<span class="text-text-muted text-xs">Proveedor:</span>
						<span id="aigen-provider-label" class="text-text-main text-xs font-semibold flex-1"></span>
						<a id="aigen-config-link" href="#" class="text-xs text-accent-text hover:underline font-medium">Cambiar</a>
					</div>

					<div class="mb-6">
						<div class="flex items-end justify-between mb-3 gap-2">
							<span class="text-sm font-semibold text-text-main">Número de preguntas</span>
							<div class="flex items-baseline gap-2">
								<span id="aigen-range-label" class="aigen-range-badge aigen-range-badge--fast">Rápido</span>
								<span class="flex items-baseline gap-1">
									<span id="aigen-count" class="text-[1.9rem] font-heading font-bold text-accent-text tabular-nums leading-none">20</span>
									<span class="text-text-muted text-xs">preg.</span>
								</span>
							</div>
						</div>

						<div class="relative py-2">
							<input
								id="aigen-slider"
								type="range" min="5" max="200" step="5" value="20"
								class="aigen-slider w-full"
								aria-label="Número de preguntas a generar"
								aria-valuemin="5" aria-valuemax="200" aria-valuenow="20"
							/>
						</div>

						<div class="flex justify-between mt-1 tabular">
							<span class="text-text-muted text-[0.68rem]">5</span>
							<span class="text-text-muted text-[0.68rem]">50</span>
							<span class="text-text-muted text-[0.68rem]">100</span>
							<span class="text-text-muted text-[0.68rem]">150</span>
							<span class="text-text-muted text-[0.68rem]">200</span>
						</div>
					</div>

					<div id="aigen-token-warning" class="hidden mb-4 p-3 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700/60 rounded-xl">
						<div class="flex items-start gap-2">
							<span class="material-icons text-amber-500 flex-shrink-0 mt-0.5" style="font-size:1rem;">warning_amber</span>
							<p class="text-amber-800 dark:text-amber-300 text-xs m-0 leading-relaxed">
								Con más de 80 preguntas la generación puede tardar varios minutos y consumir muchos tokens. Asegúrate de que tu plan de API lo permite.
							</p>
						</div>
					</div>

					<div id="aigen-error-box" role="alert" class="hidden mb-4 p-3 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-700/60 rounded-xl">
						<div class="flex items-start gap-2">
							<span class="material-icons text-danger-text flex-shrink-0 mt-0.5" style="font-size:1rem;">error_outline</span>
							<p id="aigen-error-msg" class="text-red-700 dark:text-red-400 text-xs m-0 leading-relaxed"></p>
						</div>
					</div>

					<button id="aigen-generate-btn" class="aigen-generate-btn w-full py-3 rounded-xl text-sm font-semibold cursor-pointer border-none flex items-center justify-center gap-2 transition-all">
						<span class="material-icons" style="font-size:1.1rem;">auto_fix_high</span>
						Generar preguntas
					</button>
				</div>

				<div id="aigen-generating" class="hidden">
					<div class="flex flex-col items-center py-8 gap-4">
						<div class="aigen-spinner"></div>
						<div class="text-center">
							<p id="aigen-progress-text" class="text-text-muted text-sm m-0">Conectando con la IA…</p>
							<p class="text-text-muted text-xs mt-1 m-0">Esto puede tardar unos segundos</p>
						</div>
						<button id="aigen-cancel-btn" class="mt-2 text-text-muted hover:text-text-main text-xs underline decoration-dotted cursor-pointer bg-transparent border-none transition-colors">
							Cancelar
						</button>
					</div>
				</div>

				<div id="aigen-success" class="hidden">
					<div class="flex flex-col items-center py-6 gap-4 text-center">
						<div class="w-12 h-12 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center">
							<span class="material-icons text-emerald-600 dark:text-emerald-400" style="font-size:1.6rem;">check_circle</span>
						</div>
						<div>
							<p class="text-text-main font-heading font-bold text-lg m-0">¡Quiz listo!</p>
							<p class="text-text-muted text-sm mt-1 m-0">
								<span id="aigen-success-count" class="font-bold text-text-main">0</span> preguntas nuevas generadas
							</p>
						</div>
						<div class="w-full flex flex-col gap-2 pt-2">
							<button id="aigen-start-btn" class="btn-primary w-full py-3">
								<span class="material-icons" style="font-size:1.1rem;">play_arrow</span>
								Iniciar quiz con estas preguntas
							</button>
							<button id="aigen-regenerate-btn" class="btn-secondary w-full py-2.5">
								<span class="material-icons" style="font-size:1rem;">refresh</span>
								Generar de nuevo
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- ─── AI Explanation Drawer ────────────────────────────────────────── -->
	<div id="ai-drawer" class="ai-drawer" aria-hidden="true">
		<div id="ai-drawer-backdrop" class="ai-drawer-backdrop"></div>
		<div id="ai-drawer-panel" class="ai-drawer-panel">
			<div class="flex justify-center pt-3 pb-1 sm:hidden flex-shrink-0">
				<div class="w-10 h-1 rounded-full bg-border-subtle"></div>
			</div>

			<div class="flex items-center justify-between px-5 py-3.5 border-b border-border-subtle flex-shrink-0">
				<div class="flex items-center gap-2">
					<span class="material-icons text-accent-text" style="font-size:1.15rem;">auto_awesome</span>
					<span class="font-heading font-bold text-text-main text-[0.95rem]">Explicación IA</span>
				</div>
				<div class="flex items-center gap-1.5">
					<select id="ai-drawer-provider" class="ai-drawer-select" aria-label="Proveedor de IA">
						<option value="gemini">Gemini</option>
						<option value="groq">Groq</option>
					</select>
					<select id="ai-drawer-model" class="ai-drawer-select" aria-label="Modelo de IA"></select>
					<button id="ai-drawer-close" class="ml-1 p-1.5 text-text-muted hover:text-text-main hover:bg-surface-hover rounded-lg transition-colors cursor-pointer border-none bg-transparent" aria-label="Cerrar panel">
						<span class="material-icons" style="font-size:1.2rem;">close</span>
					</button>
				</div>
			</div>

			<div class="overflow-y-auto flex-1 px-5 py-4">
				<div id="ai-question-summary" class="mb-4 p-4 bg-surface-hover rounded-xl border border-border-subtle text-sm leading-relaxed"></div>

				<div class="flex items-center gap-3 mb-4">
					<div class="flex-1 h-px bg-border-subtle"></div>
					<span class="text-[0.7rem] text-text-muted font-semibold uppercase tracking-wider">Explicación</span>
					<div class="flex-1 h-px bg-border-subtle"></div>
				</div>

				<div id="ai-loading" class="hidden flex flex-col items-center justify-center py-10 gap-3">
					<div class="ai-spinner"></div>
					<span class="text-text-muted text-sm">Generando explicación…</span>
				</div>

				<div id="ai-error" role="alert" class="hidden p-4 bg-red-50 dark:bg-red-900/20 border border-red-300 dark:border-red-700 rounded-xl mb-3">
					<div class="flex items-center gap-2 mb-1">
						<span class="material-icons text-danger-text" style="font-size:1rem;">error_outline</span>
