<style>
	@reference "../styles/global.css";

	/* ── Progreso + barra superior del quiz ─────────────────────────── */
	.quiz-progress {
		@apply absolute top-0 left-0 right-0 h-[3px] bg-border-subtle/60;
	}
	.quiz-progress-bar {
		@apply h-full rounded-r-full;
		width: 0;
		background: rgb(var(--accent));
		transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.quiz-toolbar {
		@apply flex items-center justify-between gap-3 mb-5 min-h-[38px] pb-3 border-b border-border-subtle;
	}
	.quiz-progress-label {
		@apply text-xs sm:text-[0.82rem] font-medium tracking-wide text-text-muted tabular-nums;
	}
	.quiz-progress-label :global(b) {
		@apply text-text-main font-bold;
	}
	.quiz-toolbar-actions {
		@apply flex items-center gap-1.5 ml-auto;
	}
	.quiz-tool-btn {
		@apply inline-flex items-center justify-center gap-1.5 h-9 px-2.5 rounded-lg cursor-pointer
			   border border-border-subtle bg-surface text-text-muted
			   transition-colors duration-150 hover:text-text-main hover:bg-surface-hover;
	}
	.quiz-tool-btn.hidden { display: none; }
	.quiz-tool-btn--danger:hover {
		@apply text-danger-text border-red-500/50 bg-red-500/10;
	}
	.quiz-tool-btn--ai {
		@apply border-transparent text-white bg-[rgb(var(--btn-primary))] hover:bg-[rgb(var(--btn-primary-hover))] px-3;
	}
	.quiz-tool-btn--ai:disabled {
		@apply opacity-40 cursor-not-allowed bg-surface-hover text-text-muted border-border-subtle;
	}

	@media (pointer: coarse) {
		.quiz-tool-btn { @apply min-h-[42px] min-w-[42px]; }
	}

	/* ── Transición entre preguntas ────────────────────────────────── */
	:global(.quiz-enter) {
		animation: quiz-enter 0.25s cubic-bezier(0.16, 1, 0.3, 1) backwards;
	}
	@keyframes quiz-enter {
		from { opacity: 0; transform: translateY(6px); }
		to   { opacity: 1; transform: translateY(0); }
	}
	:global(form#opciones label.correct .status-icon) {
		animation: opt-pop 0.32s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
	}
	:global(form#opciones label.incorrect) {
		animation: opt-shake 0.32s ease-in-out backwards;
	}
	@keyframes opt-pop {
		from { transform: scale(0.4); opacity: 0; }
		to   { transform: scale(1);   opacity: 1; }
	}
	@keyframes opt-shake {
		0%, 100% { transform: translateX(0); }
		25%      { transform: translateX(-3px); }
		75%      { transform: translateX(3px); }
	}

	/* Enunciado */
	.quiz-question {
		@apply mb-5 text-[1.06rem] sm:text-[1.15rem] font-medium leading-[1.65] text-text-main;
		letter-spacing: -0.005em;
	}
	.quiz-question :global(img) {
		@apply max-w-full h-auto rounded-xl border border-border-subtle my-3;
	}

	/* ── Barra de acciones del quiz ────────────────────────────────── */
	.quiz-actions {
		@apply flex flex-col gap-3 mt-6 w-full pt-4 border-t border-border-subtle;
	}
	.quiz-toolbar.hidden,
	.quiz-actions.hidden,
	.quiz-nav-btn.hidden,
	.quiz-verify-btn.hidden {
		display: none;
	}
	#mobile-total-preguntas { display: none !important; }
	#stats-panel { display: none !important; }
	.quiz-actions-primary {
		@apply grid gap-2 w-full;
		grid-template-columns: minmax(0, 1fr) minmax(0, 3fr) minmax(0, 1fr);
		align-items: stretch;
	}
	#volver-pregunta { grid-column: 1; }
	#verificar { grid-column: 2; }
	#resumenBtn { grid-column: 3; }
	.quiz-nav-btn {
		@apply inline-flex items-center justify-center gap-1 px-2.5 py-2.5 text-sm font-medium
			   text-text-muted hover:text-text-main rounded-xl border border-border-subtle
			   bg-surface hover:bg-surface-hover transition-colors cursor-pointer min-h-[46px];
	}
	.quiz-nav-btn .material-icons { font-size: 1.2rem; }
	.quiz-nav-btn-label { @apply hidden sm:inline; }
	.quiz-verify-btn {
		@apply px-5 py-2.5 text-sm sm:text-base border border-transparent text-white rounded-xl cursor-pointer
			   bg-[rgb(var(--btn-primary))] hover:bg-[rgb(var(--btn-primary-hover))] transition-colors font-semibold
			   min-h-[46px] shadow-subtle;
