	.quiz-verify-btn:disabled {
		@apply bg-surface-hover text-text-muted border-border-subtle cursor-not-allowed shadow-none;
	}

	@media (min-width: 640px) {
		.quiz-actions-primary {
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
