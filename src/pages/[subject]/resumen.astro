---
import ResumenLayout from '../../layouts/ResumenLayout.astro';

const { subject } = Astro.params;
const formattedSubject = subject ? subject.replace(/[-_]/g, ' ').toUpperCase() : 'Test';
const pageTitle = `Resumen ${formattedSubject}`;
---

<ResumenLayout title={pageTitle}>
	<div id="app" class="w-full max-w-[860px] mx-auto my-5 px-5 sm:px-10 py-8 bg-surface border border-border-subtle rounded-2xl shadow-card box-border">
		<h1 class="sr-only">Resumen de {formattedSubject}</h1>
		<div id="resumen" class="text-left text-[0.95em] leading-relaxed"></div>

		<div class="flex gap-3 mt-8 flex-wrap justify-center">
			<a href={`/${subject}`} class="btn no-underline">← Volver al test</a>
			<a href="/" class="btn no-underline">Menú principal</a>
		</div>
	</div>
</ResumenLayout>

<style>
	@reference "../../styles/global.css";
	
	:global(#resumen p) {
		@apply mb-[4px] text-text-main;
	}
	:global(#resumen li div > p:last-child) {
		@apply mb-0;
	}
	:global(#resumen li.correct) {
		@apply bg-green-500/15 text-green-700 dark:text-green-300 font-semibold;
	}
	:global(#resumen li) {
		@apply text-text-muted;
	}
	:global(#resumen strong) {
		@apply text-text-main font-semibold;
	}
</style>

<script is:inline src="/resources/js/resumen.js"></script>
