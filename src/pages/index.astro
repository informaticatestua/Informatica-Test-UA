---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
<div id="main-container" class="w-full max-w-5xl mx-auto px-4 sm:px-6 pt-8 sm:pt-10 pb-10">

	<!-- ── Command Header ──────────────────────────────────────────────────── -->
	<section class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-6">
		<div class="min-w-0">
			<h1 class="m-0 font-heading text-2xl sm:text-[1.75rem] font-semibold tracking-tight text-text-main">
				Asignaturas
			</h1>
			<p class="mt-1 mb-0 text-sm text-text-muted leading-relaxed">
				Exámenes reales, simulacros y resúmenes de Ingeniería Informática UA.
			</p>
		</div>

		<!-- Buscador rápido (atajos: / o ⌘K) -->
		<div class="subject-search w-full md:w-80 lg:w-96 flex-shrink-0">
			<span class="subject-search-icon" aria-hidden="true">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="11" cy="11" r="8"></circle>
					<path d="m21 21-4.3-4.3"></path>
				</svg>
			</span>
			<input id="subject-search" type="search" autocomplete="off" spellcheck="false"
				placeholder="Buscar asignatura o examen…" aria-label="Buscar asignatura o examen"
				aria-controls="search-results" />
			<button id="search-clear" type="button" class="subject-search-clear hidden" aria-label="Limpiar búsqueda">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M18 6 6 18"></path>
					<path d="m6 6 12 12"></path>
				</svg>
			</button>
			<kbd class="subject-search-kbd" aria-hidden="true">/</kbd>
		</div>
	</section>

	<!-- ── Retomar último test (solo con sesión y progreso guardado) ───────── -->
	<a id="continue-card" href="#" class="continue-card hidden mb-6">
		<div class="continue-card-left">
			<span class="continue-card-icon" aria-hidden="true">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
					<polygon points="6 4 20 12 6 20 6 4"></polygon>
				</svg>
			</span>
			<div class="continue-card-body">
				<div class="continue-card-headline">
					<span class="continue-card-eyebrow">Continuar</span>
					<span class="continue-card-sep" aria-hidden="true">·</span>
					<span id="continue-card-title" class="continue-card-title"></span>
					<span class="continue-card-sep hidden sm:inline" aria-hidden="true">·</span>
					<span id="continue-card-meta" class="continue-card-meta"></span>
				</div>
				<div class="continue-progress-track" aria-hidden="true">
					<div id="continue-card-progress-fill" class="continue-progress-fill"></div>
				</div>
			</div>
		</div>
		<span class="continue-card-cta">
			<span>Continuar</span>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M5 12h14"></path>
				<path d="m12 5 7 7-7 7"></path>
			</svg>
		</span>
	</a>

	<!-- ── Pestañas de filtro por curso ────────────────────────────────────── -->
	<div id="category-filter-bar" class="hidden cat-tabs -mx-4 px-4 sm:mx-0 sm:px-0 mb-8" role="group" aria-label="Filtrar por curso"></div>

	<!-- ── Estado de carga (esqueleto abierto) ─────────────────────────────── -->
	<div id="subjects-loading" class="subjects-skeleton" aria-busy="true" aria-live="polite">
		<span class="sr-only">Cargando asignaturas…</span>
		<div class="skeleton-block">
			<div class="skeleton-heading"></div>
			<div class="skeleton-grid"><i></i><i></i><i></i><i></i><i></i><i></i></div>
		</div>
		<div class="skeleton-block">
			<div class="skeleton-heading"></div>
			<div class="skeleton-grid"><i></i><i></i><i></i></div>
		</div>
	</div>

	<!-- ── Resultados de búsqueda (relleno por JS) ────────────────────────── -->
	<div id="search-results" class="search-results hidden" role="listbox" aria-label="Resultados de búsqueda"></div>

	<!-- ── Catálogo abierto de asignaturas ─────────────────────────────────── -->
	<div id="asignaturas-container" class="hidden space-y-10"></div>

</div>

<script is:inline>
(function () {
	"use strict";

	// ─── Configuración ───────────────────────────────────────────────────────

	const CATEGORY_LABELS = {
		software:    "Especialidad / Rama",
		third_year:  "Tercer Curso",
		second_year: "Segundo Curso",
		first_year:  "Primer Curso",
		other:       "Otros",
	};

	const FILTER_SHORT_LABELS = {
		all:         "Todas",
		software:    "Especialidad",
		third_year:  "3.º Curso",
		second_year: "2.º Curso",
		first_year:  "1.º Curso",
		other:       "Otros",
	};

	const CATEGORY_ORDER = ["software", "third_year", "second_year", "first_year", "other"];

	const SYNTHETIC_FULL = {
		sds:          { id: "sdsfull",    display_name: "SDS Full" },
		redes_parent: { id: "redes_full", display_name: "Redes Full" },
	};

	const SECTION_BUTTONS = {
		hada: [
			{ label: "HADA Julio 2026", src: "HADA Julio 2026" },
			{ label: "HADA Full",       src: "hadaPreguntas.txt" },
		],
		ped: [
			{ label: "PED Junio 2025", src: "Junio 2025" },
			{ label: "PED Junio 2026", src: "Junio 2026" },
			{ label: "PED Full",       src: "PED Full" },
		],
	};

	const DEPRECATED_SUBJECTS = new Set([]);
	const NEW_SUBJECTS = new Set(["p2", "si", "ir", "dbd"]);
	const HIDDEN_SUBJECTS = new Set(["redesGeneral"]);

	// ─── Iconos SVG inline ───────────────────────────────────────────────────

	const ICON_ARROW =
		'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>';
	const ICON_CHEVRON =
		'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>';
	const ICON_CLOSE =
		'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>';
	const ICON_LAYERS =
		'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2 2 7l10 5 10-5-10-5Z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/></svg>';
	const ICON_SPARKLES =
		'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/></svg>';

	// ─── Helpers ─────────────────────────────────────────────────────────────

	function getChildCount(subject, children) {
		const kids = (children[subject.id] || []).filter((c) => !HIDDEN_SUBJECTS.has(c.id));
		const synth = SYNTHETIC_FULL[subject.id] ? 1 : 0;
		const secs = SECTION_BUTTONS[subject.id] ? SECTION_BUTTONS[subject.id].length : 0;
		return kids.length + synth + secs;
	}

	function closeAllSublists(container, returnFocus) {
		if (!container) return;
		const openBtn = container.querySelector("button.subject-open");
		container.querySelectorAll('[id$="-sublist"]').forEach((sl) => {
			sl.classList.remove("sublist-open");
			sl.classList.add("hidden");
		});
		container.querySelectorAll("button.subject-open").forEach((b) => {
			b.classList.remove("subject-open");
			b.setAttribute("aria-expanded", "false");
		});
		if (returnFocus && openBtn) openBtn.focus();
	}

	// ─── Renderizado ─────────────────────────────────────────────────────────

	function buildSublist(subject, children) {
		const totalCount = getChildCount(subject, { [subject.id]: children });
		const div = document.createElement("div");
		div.id = `${subject.id}-sublist`;
		div.className = "hidden sublist-panel";

		const header = document.createElement("div");
		header.className = "sublist-header";

		const titleWrap = document.createElement("div");
		titleWrap.className = "sublist-title-wrap";
		const h4 = document.createElement("h4");
		h4.className = "sublist-title";
		h4.textContent = subject.display_name;
		const countMeta = document.createElement("span");
		countMeta.className = "sublist-count tabular";
		countMeta.textContent = `${totalCount} ${totalCount === 1 ? "módulo" : "módulos"}`;
		titleWrap.appendChild(h4);
		titleWrap.appendChild(countMeta);

		const closeBtn = document.createElement("button");
		closeBtn.type = "button";
		closeBtn.className = "sublist-close";
		closeBtn.setAttribute("aria-label", `Cerrar módulos de ${subject.display_name}`);
		closeBtn.innerHTML = ICON_CLOSE;
		closeBtn.addEventListener("click", (e) => {
			e.stopPropagation();
			div.classList.remove("sublist-open");
			div.classList.add("hidden");
			const triggerBtn = document.getElementById(subject.id);
			if (triggerBtn) {
				triggerBtn.classList.remove("subject-open");
				triggerBtn.setAttribute("aria-expanded", "false");
				triggerBtn.focus();
			}
		});

		header.appendChild(titleWrap);
		header.appendChild(closeBtn);
		div.appendChild(header);

		const row = document.createElement("div");
		row.className = "asignaturas listaoculta sublist-grid";

		// Botón FULL sintético (primero)
		const synth = SYNTHETIC_FULL[subject.id];
		if (synth) {
			const btn = document.createElement("button");
			btn.id = synth.id;
			btn.className = "sublist-btn sublist-btn--primary";
			btn.innerHTML = `<span class="sublist-btn-icon">${ICON_LAYERS}</span><span class="sublist-btn-text">${window.Utils.esc(synth.display_name)}</span><span class="sublist-btn-arrow">${ICON_ARROW}</span>`;
			btn.addEventListener("click", () => { window.location.href = `/${synth.id}`; });
			row.appendChild(btn);
		}

		for (const child of children) {
			if (HIDDEN_SUBJECTS.has(child.id)) continue;
			const btn = document.createElement("button");
			const showBadge = child.is_ai_generated && !subject.is_ai_generated;
			btn.id = child.id;
			btn.className = "sublist-btn" + (showBadge ? " btn-primary--ai" : "");

			const labelSpan = document.createElement("span");
			labelSpan.className = "sublist-btn-text";
			labelSpan.textContent = child.display_name;
			btn.appendChild(labelSpan);

			if (showBadge) btn.appendChild(makeAiBadge());

			const arrow = document.createElement("span");
			arrow.className = "sublist-btn-arrow";
			arrow.innerHTML = ICON_ARROW;
			btn.appendChild(arrow);

			btn.addEventListener("click", () => { window.location.href = `/${child.id}`; });
			row.appendChild(btn);
		}

		// Botones de sección (source_file dentro del mismo subject_id)
		const sections = SECTION_BUTTONS[subject.id];
		if (sections) {
			for (const sec of sections) {
				const btn = document.createElement("button");
				const isFull = /full/i.test(sec.label);
				btn.className = isFull ? "sublist-btn sublist-btn--primary" : "sublist-btn";
				btn.innerHTML = `${isFull ? `<span class="sublist-btn-icon">${ICON_LAYERS}</span>` : ""}<span class="sublist-btn-text">${window.Utils.esc(sec.label)}</span><span class="sublist-btn-arrow">${ICON_ARROW}</span>`;
				btn.addEventListener("click", () => {
					window.location.href = `/${subject.id}?src=${encodeURIComponent(sec.src)}`;
				});
				row.appendChild(btn);
			}
		}

		div.appendChild(row);
		return div;
	}

	function renderCardsGrid(items, children, target, subtitleText) {
		if (!items || items.length === 0) return;

		if (subtitleText) {
			const label = document.createElement("p");
			label.className = "semester-label";
			label.textContent = subtitleText;
			target.appendChild(label);
		}

		const grid = document.createElement("div");
		grid.className = "subject-grid";
		for (const s of items) {
			grid.appendChild(makeTopBtn(s, children));
		}
		target.appendChild(grid);

		for (const s of items) {
			const count = getChildCount(s, children);
			if (count > 0) {
				target.appendChild(buildSublist(s, children[s.id] || []));
			}
		}
	}

	function renderCategoryGrid(tops, children, target) {
		const hasExplicit = tops.some((s) => s.semester === 1 || s.semester === 2);

		if (hasExplicit) {
			const firstSem  = tops.filter((s) => s.semester !== 2);
			const secondSem = tops.filter((s) => s.semester === 2);
			if (firstSem.length > 0 && secondSem.length > 0) {
				renderCardsGrid(firstSem, children, target, "1.er cuatrimestre");
				renderCardsGrid(secondSem, children, target, "2.º cuatrimestre");
				return;
			}
		}

		renderCardsGrid(tops, children, target, null);
	}

	function getCategoryCount(cat, topLevel) {
		if (cat === "software") {
			return (topLevel["software"]?.length || 0) + (topLevel["ti"]?.length || 0);
		}
		return topLevel[cat]?.length || 0;
	}

	function renderFilterBar(categoriesToShow, topLevel, container) {
		const bar = document.getElementById("category-filter-bar");
		if (!bar) return;
		bar.innerHTML = "";

		const totalAll = categoriesToShow.reduce((acc, cat) => acc + getCategoryCount(cat, topLevel), 0);
		const options = ["all", ...categoriesToShow];
		let activeCat = "all";

		const applyFilter = () => {
			bar.querySelectorAll(".cat-tab").forEach((tab) => {
				const isOn = tab.dataset.cat === activeCat;
				tab.classList.toggle("is-active", isOn);
				tab.setAttribute("aria-pressed", String(isOn));
			});
			container.querySelectorAll(".subject-section").forEach((sec) => {
				const show = activeCat === "all" || sec.dataset.category === activeCat;
				sec.classList.toggle("hidden", !show);
			});
			closeAllSublists(container, false);
		};

		for (const cat of options) {
			const btn = document.createElement("button");
			btn.type = "button";
			btn.dataset.cat = cat;
			btn.className = "cat-tab" + (cat === "all" ? " is-active" : "");
			btn.setAttribute("aria-pressed", cat === "all" ? "true" : "false");

			const label = document.createElement("span");
			label.textContent = FILTER_SHORT_LABELS[cat] || CATEGORY_LABELS[cat] || cat;
			btn.appendChild(label);

			const count = cat === "all" ? totalAll : getCategoryCount(cat, topLevel);
			const badge = document.createElement("span");
			badge.className = "cat-tab-count tabular";
			badge.textContent = String(count);
			btn.appendChild(badge);

			btn.addEventListener("click", () => {
				activeCat = cat;
				applyFilter();
			});
			bar.appendChild(btn);
		}

		bar.classList.remove("hidden");
	}

	function renderSubjects(subjects) {
		const container = document.getElementById("asignaturas-container");
		if (!container) return;
		container.innerHTML = "";

		const topLevel = {};
		const children = {};

		for (const s of subjects) {
			if (s.parent_id === null) {
				if (!topLevel[s.category]) topLevel[s.category] = [];
				topLevel[s.category].push(s);
			} else {
				if (!children[s.parent_id]) children[s.parent_id] = [];
				children[s.parent_id].push(s);
			}
		}

		const categoriesToShow = CATEGORY_ORDER.filter(
			(cat) => topLevel[cat] && topLevel[cat].length > 0,
		);

		renderFilterBar(categoriesToShow, topLevel, container);

		for (const cat of categoriesToShow) {
			const tops = topLevel[cat];
			const section = document.createElement("section");
			section.className = "subject-section";
			section.dataset.category = cat;

			if (cat === "software") {
				const tiTops = topLevel["ti"] || [];
				const headerRow = document.createElement("div");
				headerRow.className = "section-header";

				const titleGroup = document.createElement("div");
				titleGroup.className = "section-title-group";
				const h2 = document.createElement("h2");
				h2.className = "section-title";
				h2.textContent = CATEGORY_LABELS[cat];
				const countBadge = document.createElement("span");
				countBadge.className = "section-count tabular";
				countBadge.textContent = `${tops.length} ${tops.length === 1 ? "asignatura" : "asignaturas"}`;
				titleGroup.appendChild(h2);
				titleGroup.appendChild(countBadge);

				// Segmented switcher Software / TI
				const switcher = document.createElement("div");
				switcher.className = "rama-switcher";
				switcher.setAttribute("role", "group");
				switcher.setAttribute("aria-label", "Seleccionar especialidad");

				const RAMAS = [
					{ id: "software", label: "Software", count: tops.length },
					{ id: "ti",       label: "TI",       title: "Tecnologías de la Información", count: tiTops.length },
				];

				const subjectsWrap = document.createElement("div");
				subjectsWrap.id = "software-subjects-wrap";

				const tiWrap = document.createElement("div");
				tiWrap.id = "ti-subjects-wrap";
				tiWrap.className = "hidden";

				const placeholder = document.createElement("div");
				placeholder.id = "software-placeholder";
				placeholder.className = "hidden rama-placeholder";

				RAMAS.forEach((rama, idx) => {
					const b = document.createElement("button");
					b.type = "button";
					b.className = "rama-switch-btn" + (idx === 0 ? " is-active" : "");
					b.setAttribute("aria-pressed", idx === 0 ? "true" : "false");
					if (rama.title) b.title = rama.title;
					b.textContent = rama.label;
					b.addEventListener("click", () => {
						switcher.querySelectorAll(".rama-switch-btn").forEach((el) => {
							el.classList.remove("is-active");
							el.setAttribute("aria-pressed", "false");
						});
						b.classList.add("is-active");
						b.setAttribute("aria-pressed", "true");
						countBadge.textContent = `${rama.count} ${rama.count === 1 ? "asignatura" : "asignaturas"}`;
						closeAllSublists(section, false);

						if (rama.id === "software") {
							subjectsWrap.classList.remove("hidden");
							tiWrap.classList.add("hidden");
							placeholder.classList.add("hidden");
						} else {
							subjectsWrap.classList.add("hidden");
							tiWrap.classList.remove("hidden");
							placeholder.classList.add("hidden");
						}
					});
					switcher.appendChild(b);
				});

				headerRow.appendChild(titleGroup);
				headerRow.appendChild(switcher);
				section.appendChild(headerRow);

				renderCategoryGrid(tops, children, subjectsWrap);
				section.appendChild(subjectsWrap);

				if (tiTops.length > 0) {
					renderCategoryGrid(tiTops, children, tiWrap);
				}
				section.appendChild(tiWrap);
				section.appendChild(placeholder);
			} else {
				const headerRow = document.createElement("div");
				headerRow.className = "section-header";

				const titleGroup = document.createElement("div");
				titleGroup.className = "section-title-group";
				const h2 = document.createElement("h2");
				h2.className = "section-title";
				h2.textContent = CATEGORY_LABELS[cat] || cat;

				const countBadge = document.createElement("span");
				countBadge.className = "section-count tabular";
				countBadge.textContent = `${tops.length} ${tops.length === 1 ? "asignatura" : "asignaturas"}`;

				titleGroup.appendChild(h2);
				titleGroup.appendChild(countBadge);
				headerRow.appendChild(titleGroup);
				section.appendChild(headerRow);

				renderCategoryGrid(tops, children, section);
			}

			container.appendChild(section);
		}

		// Delegación de clics para abrir/cerrar sublists
		container.addEventListener("click", function (e) {
			const btn = e.target.closest("button.subject-card");
			if (!btn) return;
			const sublistId = btn.id + "-sublist";
			const sublist = document.getElementById(sublistId);
			if (sublist) {
				const isOpen = !sublist.classList.contains("hidden");
				container.querySelectorAll('[id$="-sublist"]').forEach((sl) => {
					if (sl.id !== sublistId) {
						sl.classList.add("hidden");
						sl.classList.remove("sublist-open");
					}
				});
				container.querySelectorAll("button.subject-open").forEach((b) => {
					if (b !== btn) {
						b.classList.remove("subject-open");
						b.setAttribute("aria-expanded", "false");
					}
				});
				if (isOpen) {
					sublist.classList.remove("sublist-open");
					sublist.classList.add("hidden");
					btn.classList.remove("subject-open");
					btn.setAttribute("aria-expanded", "false");
				} else {
					sublist.classList.remove("hidden");
					btn.classList.add("subject-open");
					btn.setAttribute("aria-expanded", "true");
					requestAnimationFrame(() => requestAnimationFrame(() => {
						sublist.classList.add("sublist-open");
						sublist.scrollIntoView({ behavior: "smooth", block: "nearest" });
					}));
				}
			}
		});
	}

	function makeAiBadge() {
		const badge = document.createElement("span");
		badge.className = "ai-badge";
		badge.setAttribute("aria-label", "Preguntas generadas con IA, no provienen de exámenes reales");
		badge.innerHTML = `${ICON_SPARKLES}<span>IA</span>`;
		return badge;
	}

	function makeTopBtn(subject, children) {
		const childCount = getChildCount(subject, children);
		const hasChildren = childCount > 0;

		const btn = document.createElement("button");
		btn.type = "button";
		btn.id = subject.id;
		btn.className = "subject-card";

		if (hasChildren) {
			btn.setAttribute("aria-expanded", "false");
			btn.setAttribute("aria-controls", `${subject.id}-sublist`);
		}

		const titleRow = document.createElement("div");
		titleRow.className = "subject-card-title-row";

		const nameSpan = document.createElement("span");
		nameSpan.className = "subject-card-name";
		nameSpan.textContent = subject.display_name;
		titleRow.appendChild(nameSpan);

		if (NEW_SUBJECTS.has(subject.id)) {
			const newBadge = document.createElement("span");
			newBadge.className = "new-badge";
			newBadge.textContent = "Nuevo";
			titleRow.appendChild(newBadge);
		}

		if (DEPRECATED_SUBJECTS.has(subject.id)) {
			btn.classList.add("is-deprecated");
			const badge = document.createElement("span");
			badge.className = "deprecated-badge";
			badge.title = "Esta asignatura ya no se imparte o ha sido reemplazada";
			badge.textContent = "Antiguo";
			titleRow.appendChild(badge);
		}

		if (subject.is_ai_generated) {
			titleRow.appendChild(makeAiBadge());
		}

		btn.appendChild(titleRow);

		const rightGroup = document.createElement("div");
		rightGroup.className = "subject-card-right";

		if (hasChildren) {
			const countPill = document.createElement("span");
			countPill.className = "subject-card-count tabular";
			countPill.textContent = `${childCount} ${childCount === 1 ? "módulo" : "módulos"}`;
			rightGroup.appendChild(countPill);
		}

		const rightIcon = document.createElement("span");
		rightIcon.className = hasChildren ? "subject-chevron" : "subject-arrow";
		rightIcon.innerHTML = hasChildren ? ICON_CHEVRON : ICON_ARROW;
		rightGroup.appendChild(rightIcon);

		btn.appendChild(rightGroup);

		if (!hasChildren) {
			btn.addEventListener("click", () => { window.location.href = `/${subject.id}`; });
		}

		return btn;
	}

	// ─── Buscador ────────────────────────────────────────────────────────────

	const norm = (s) => String(s).normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().replace(/[^a-z0-9\s-]/g, " ");

	function buildSearchIndex(subjects) {
		const byId = new Map(subjects.map((s) => [s.id, s]));
		const kids = {};
		for (const s of subjects) {
			if (s.parent_id) (kids[s.parent_id] = kids[s.parent_id] || []).push(s);
		}
		const out = [];
		const add = (label, group, href) =>
			out.push({ label, group, href, hay: norm(`${label} ${group}`) });

		for (const s of subjects) {
			if (HIDDEN_SUBJECTS.has(s.id)) continue;
			if (s.parent_id) {
				const parent = byId.get(s.parent_id);
				add(s.display_name, parent ? parent.display_name : "", `/${s.id}`);
				continue;
			}
			const children = (kids[s.id] || []).filter((c) => !HIDDEN_SUBJECTS.has(c.id));
			const synth = SYNTHETIC_FULL[s.id];
			const sections = SECTION_BUTTONS[s.id];
			if (!children.length && !synth && !sections) {
				add(s.display_name, CATEGORY_LABELS[s.category] || "", `/${s.id}`);
				continue;
			}
			if (synth) add(synth.display_name, s.display_name, `/${synth.id}`);
			for (const sec of sections || []) {
				add(sec.label, s.display_name, `/${s.id}?src=${encodeURIComponent(sec.src)}`);
			}
		}
		return out;
	}

	function initSearch(index) {
		const input     = document.getElementById("subject-search");
		const clearBtn  = document.getElementById("search-clear");
		const results   = document.getElementById("search-results");
		const container = document.getElementById("asignaturas-container");
		const filterBar = document.getElementById("category-filter-bar");
		if (!input || !results || !container) return;

		const esc = window.Utils.esc;
		let matches = [];
		let active  = 0;

		function paintActive() {
			results.querySelectorAll(".search-item").forEach((el, i) => {
				const on = i === active;
				el.classList.toggle("is-active", on);
				el.setAttribute("aria-selected", on ? "true" : "false");
				if (on) el.scrollIntoView({ block: "nearest" });
			});
		}

		function render() {
			const raw = input.value.trim();
			clearBtn?.classList.toggle("hidden", !raw);
			const terms = norm(raw).split(/\s+/).filter(Boolean);

			if (!raw || terms.length === 0) {
				results.classList.add("hidden");
				results.innerHTML = "";
				container.classList.remove("hidden");
				filterBar?.classList.remove("hidden");
				return;
			}
			matches = index.filter((e) => terms.every((t) => e.hay.includes(t))).slice(0, 30);
			active = 0;
			container.classList.add("hidden");
			filterBar?.classList.add("hidden");
			results.classList.remove("hidden");
			if (matches.length === 0) {
				results.innerHTML = `<p class="search-empty">Sin resultados para «${esc(raw)}»</p>`;
				return;
			}
			results.innerHTML = matches.map((m, i) =>
				`<a role="option" href="${esc(m.href)}" class="search-item" aria-selected="${i === 0}">` +
					`<span class="search-item-label">${esc(m.label)}</span>` +
					(m.group ? `<span class="search-item-group">${esc(m.group)}</span>` : "") +
					`<span class="search-item-arrow">${ICON_ARROW}</span>` +
				`</a>`
			).join("");
			paintActive();
		}

		input.addEventListener("input", render);
		clearBtn?.addEventListener("click", () => {
			input.value = "";
			render();
			input.focus();
		});

		input.addEventListener("keydown", (e) => {
			if (e.key === "ArrowDown" && matches.length) {
				e.preventDefault();
				active = (active + 1) % matches.length;
				paintActive();
			} else if (e.key === "ArrowUp" && matches.length) {
				e.preventDefault();
				active = (active - 1 + matches.length) % matches.length;
				paintActive();
			} else if (e.key === "Enter" && matches[active]) {
				e.preventDefault();
				window.location.href = matches[active].href;
			} else if (e.key === "Escape") {
				input.value = "";
				render();
				input.blur();
			}
		});

		document.addEventListener("keydown", (e) => {
			if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
				e.preventDefault();
				input.focus();
				input.select();
				return;
			}
			if (e.key === "Escape" && document.activeElement !== input) {
				const openPanel = container.querySelector(".sublist-panel:not(.hidden)");
				if (openPanel) {
					const focusInside = openPanel.contains(document.activeElement);
					closeAllSublists(container, focusInside);
				}
				return;
			}
			if (e.key !== "/" || e.ctrlKey || e.metaKey || e.altKey) return;
			const t = e.target;
			if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
			e.preventDefault();
			input.focus();
			input.select();
		});
	}

	// ─── Continuar donde lo dejaste ──────────────────────────────────────────

	function initContinue(subjects) {
		const card = document.getElementById("continue-card");
		if (!card) return;

		async function run() {
			const db  = window.SupabaseClient;
			const uid = window.Utils?.userId();
			if (!db || !uid) return;

			const { data, error } = await db
				.from("test_progress")
				.select("quiz_key, current_index, answered_count, question_ids")
				.eq("user_id", uid)
				.order("updated_at", { ascending: false })
				.limit(1)
				.maybeSingle();
			if (error || !data) return;

			const total = Array.isArray(data.question_ids) ? data.question_ids.length : 0;
			if (!total || data.answered_count >= total) return;

			const subj  = subjects.find((s) => s.id === data.quiz_key);
			const synth = Object.values(SYNTHETIC_FULL).find((s) => s.id === data.quiz_key);
			const name  = subj ? subj.display_name : synth ? synth.display_name : data.quiz_key.toUpperCase();
			const pct   = Math.round((data.answered_count / total) * 100);

			card.href = `/${data.quiz_key}`;
			document.getElementById("continue-card-title").textContent = name;
			document.getElementById("continue-card-meta").textContent =
				`Pregunta ${Math.min(data.current_index + 1, total)} de ${total} · ${pct}% completado`;
			const fill = document.getElementById("continue-card-progress-fill");
			if (fill) fill.style.width = `${pct}%`;
			card.classList.remove("hidden");
		}

		if (window.Auth && typeof window.Auth.onReady === "function") window.Auth.onReady(run);
		else run();
	}

	// ─── Carga de datos ──────────────────────────────────────────────────────

	async function loadSubjects() {
		const loading   = document.getElementById("subjects-loading");
		const container = document.getElementById("asignaturas-container");

		const db = window.SupabaseClient;
		if (!db) {
			if (loading) loading.innerHTML = '<p class="text-text-muted text-sm text-center py-8">No se pudo conectar con la base de datos.</p>';
			return;
		}

		try {
			const { data, error } = await db
				.from("subjects")
				.select("id, display_name, category, parent_id, sort_order, semester, is_ai_generated")
				.order("sort_order", { ascending: true });

			if (error) throw error;

			if (loading)   loading.classList.add("hidden");
			if (container) container.classList.remove("hidden");

			renderSubjects(data || []);
			initSearch(buildSearchIndex(data || []));
			initContinue(data || []);
		} catch (err) {
			console.error("[Index] Error cargando asignaturas:", err);
			if (loading) loading.innerHTML = '<p class="text-text-muted text-sm text-center py-8">Error al cargar las asignaturas. Recarga la página.</p>';
		}
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", loadSubjects);
	} else {
		loadSubjects();
	}
})();
</script>
</BaseLayout>

