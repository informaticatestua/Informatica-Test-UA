---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>

<div id="main-container" class="flex flex-col items-center justify-center m-auto w-full">
	<div id="app" class="relative w-full max-w-[860px] text-center bg-surface/90 backdrop-blur shadow-card rounded-3xl px-[40px] py-[32px] mx-auto my-[20px] box-border border border-border-subtle animate-fade-in-up">

		<div class="mb-5">
			<h1 class="m-0 text-2xl sm:text-3xl font-bold tracking-tight">Elige una asignatura</h1>
			<p class="mt-1.5 mb-0 text-sm text-text-muted">Practica con tests reales y simulacros de la UA</p>
		</div>

		<!-- Buscador rápido (atajo: /) -->
		<div class="subject-search">
			<span class="material-icons subject-search-icon" aria-hidden="true">search</span>
			<input id="subject-search" type="search" autocomplete="off" spellcheck="false"
				placeholder="Buscar asignatura o examen…" aria-label="Buscar asignatura o examen"
				aria-controls="search-results" />
			<kbd class="subject-search-kbd" aria-hidden="true">/</kbd>
		</div>

		<!-- Retomar último test (solo con sesión y progreso guardado) -->
		<a id="continue-card" href="#" class="continue-card hidden">
			<span class="continue-card-icon material-icons" aria-hidden="true">play_arrow</span>
			<span class="continue-card-body">
				<span class="continue-card-eyebrow">Continuar donde lo dejaste</span>
				<span id="continue-card-title" class="continue-card-title"></span>
				<span id="continue-card-meta" class="continue-card-meta"></span>
			</span>
			<span class="continue-card-arrow material-icons" aria-hidden="true">arrow_forward</span>
		</a>

		<!-- Estado de carga (esqueleto) -->
		<div id="subjects-loading" class="subjects-skeleton" aria-busy="true" aria-live="polite">
			<span class="sr-only">Cargando asignaturas…</span>
			<div class="skeleton-row"><i></i><i></i><i></i><i></i></div>
			<div class="skeleton-row"><i></i><i></i><i></i></div>
			<div class="skeleton-row"><i></i><i></i><i></i><i></i><i></i></div>
		</div>

		<!-- Resultados de búsqueda (relleno por JS) -->
		<div id="search-results" class="search-results hidden" role="listbox" aria-label="Resultados de búsqueda"></div>

		<!-- Contenedor dinámico (relleno por JS) -->
		<div id="asignaturas-container" class="hidden"></div>

	</div>

	<!-- Card de contacto -->
	<div class="w-fit max-w-[95vw] bg-surface/70 rounded-2xl px-[24px] py-[14px] mx-auto mb-[20px] box-border border border-border-subtle">
		<div class="flex items-center justify-center gap-3 text-center flex-wrap">
			<span class="material-icons mi-md text-[rgb(var(--color-primary-rgb))]" aria-hidden="true">mail_outline</span>
			<p class="text-sm text-text-muted m-0">
				¿Alguna consulta? Escríbenos a
				<a href="mailto:informaticatestua@gmail.com" class="font-semibold text-[rgb(var(--color-primary-rgb))] hover:underline">informaticatestua@gmail.com</a>
			</p>
		</div>
	</div>
</div>

<script is:inline>
(function () {
	"use strict";

	// ─── Configuración ───────────────────────────────────────────────────────

	const CATEGORY_LABELS = {
		software:    "Rama Software",
		third_year:  "Tercer Curso",
		second_year: "Segundo Curso",
		first_year:  "Primer Curso",
		other:       "Otros",
	};

	const CATEGORY_ORDER = ["software", "third_year", "second_year", "first_year", "other"];

	/**
	 * Botón sintético "FULL" que agrupa todos los hijos de un padre.
	 * Se inserta como primer hijo en la sublista de su parent_id.
	 */
	const SYNTHETIC_FULL = {
		sds:          { id: "sdsfull",    display_name: "SDS Full" },
		redes_parent: { id: "redes_full", display_name: "Redes Full" },
	};

	/**
	 * Secciones dentro de un mismo subject_id (columna `source_file`).
	 * Cada botón navega a `/{id}?src=<source_file>`, y el motor del quiz
	 * (main.js → QuizData) carga solo las preguntas de esa sección.
	 * El nº de preguntas se obtiene por consulta (no hardcodeado).
	 */
	const SECTION_BUTTONS = {
		hada: [
			{ label: "HADA Julio 2026", src: "HADA Julio 2026" },
			{ label: "HADA Full",       src: "hadaPreguntas.txt" },
		],
		ped: [
			{ label: "PED Junio 2025", src: "Junio 2025" },
			{ label: "PED Junio 2026", src: "Junio 2026" },
			{ label: "PED Full",       src: "PED Full" },
		],
	};

	/** IDs de asignaturas marcadas como deprecadas (muestran badge). */
	const DEPRECATED_SUBJECTS = new Set([]);

	/** IDs de asignaturas con badge "Nuevo" superpuesto. */
	const NEW_SUBJECTS = new Set(["p2", "si", "ir", "dbd"]);

	/**
	 * IDs de asignaturas que NO se muestran como botón propio, pero siguen
	 * existiendo en BD y agregándose en su "FULL" sintético. P. ej.
	 * "redesGeneral" es el banco completo de redes: se accede vía "Redes Full",
	 * sin botón individual.
	 */
	const HIDDEN_SUBJECTS = new Set(["redesGeneral"]);

	// ─── Renderizado ─────────────────────────────────────────────────────────

	function buildSublist(subject, children) {
		const div = document.createElement("div");
		div.id = `${subject.id}-sublist`;
		div.className = "hidden sublist-panel flex flex-col items-center";

		const h4 = document.createElement("h4");
		h4.className = "mt-0 mb-4 text-[0.78rem] font-bold tracking-[0.1em] uppercase text-text-muted";
		h4.textContent = `Exámenes ${subject.display_name}`;
		div.appendChild(h4);

		const row = document.createElement("div");
		row.className = "asignaturas listaoculta flex justify-center items-center flex-wrap gap-3 w-full max-w-[800px]";

		// Botón FULL sintético (primero)
		const synth = SYNTHETIC_FULL[subject.id];
		if (synth) {
			const btn = document.createElement("button");
			btn.id = synth.id;
			btn.className = "btn-primary";
			btn.textContent = synth.display_name;
			btn.addEventListener("click", () => { window.location.href = `/${synth.id}`; });
			row.appendChild(btn);
		}

		for (const child of children) {
			if (HIDDEN_SUBJECTS.has(child.id)) continue;
			const btn = document.createElement("button");
			// Solo mostrar badge en el hijo si el padre NO ya es IA (evita redundancia)
			const showBadge = child.is_ai_generated && !subject.is_ai_generated;
			btn.id = child.id;
			btn.className = "btn-primary" + (showBadge ? " btn-primary--ai" : "");
			if (showBadge) {
				const nameSpan = document.createElement("span");
				nameSpan.textContent = child.display_name;
				btn.appendChild(nameSpan);
				btn.appendChild(makeAiBadge());
			} else {
				btn.textContent = child.display_name;
			}
			btn.addEventListener("click", () => { window.location.href = `/${child.id}`; });
			row.appendChild(btn);
		}

		// Botones de sección (source_file dentro del mismo subject_id).
		const sections = SECTION_BUTTONS[subject.id];
		if (sections) {
			for (const sec of sections) {
				const btn = document.createElement("button");
				btn.className = "btn-primary";
				btn.textContent = sec.label;
				btn.addEventListener("click", () => {
					window.location.href = `/${subject.id}?src=${encodeURIComponent(sec.src)}`;
				});
				row.appendChild(btn);
			}
		}

		div.appendChild(row);
		return div;
	}

	function renderCategoryGrid(tops, children, target) {
		const hasManyButtons = tops.length > 1;

		if (!hasManyButtons) {
			const centered = document.createElement("div");
			centered.className = "flex justify-center w-full mb-[20px]";
			centered.appendChild(makeTopBtn(tops[0], children));
			target.appendChild(centered);
		} else {
			const hasExplicit = tops.some((s) => s.semester !== null && s.semester !== undefined);
			let leftGroup, rightGroup;
			if (hasExplicit) {
				leftGroup  = tops.filter((s) => s.semester !== 2);
				rightGroup = tops.filter((s) => s.semester === 2);
			} else {
				const mid = Math.ceil(tops.length / 2);
				leftGroup  = tops.slice(0, mid);
				rightGroup = tops.slice(mid);
			}

			const grid = document.createElement("div");
			grid.className = "asignaturas grid grid-cols-[auto_2px_auto] gap-[20px] mx-auto mb-[20px] items-center";

			const leftDiv = document.createElement("div");
			leftDiv.className = "group-left flex justify-end gap-[10px] flex-wrap";
			for (const s of leftGroup) leftDiv.appendChild(makeTopBtn(s, children));

			const sep = document.createElement("div");
			sep.className = "separator w-[2px] h-[35px] bg-border-subtle mx-auto";

			const rightDiv = document.createElement("div");
			rightDiv.className = "group-right flex justify-start gap-[10px] flex-wrap";
			for (const s of rightGroup) rightDiv.appendChild(makeTopBtn(s, children));

			grid.appendChild(leftDiv);
			grid.appendChild(sep);
			grid.appendChild(rightDiv);
			target.appendChild(grid);
		}

		for (const s of tops) {
			const kids = children[s.id] || [];
			const hasSynth = !!SYNTHETIC_FULL[s.id];
			const hasSections = !!SECTION_BUTTONS[s.id];
			if (kids.length > 0 || hasSynth || hasSections) {
				target.appendChild(buildSublist(s, kids));
			}
		}
	}

	function renderSubjects(subjects) {
		const container = document.getElementById("asignaturas-container");
		if (!container) return;
		container.innerHTML = "";

		// Separar top-level y children
		const topLevel = {};   // category → [subject]
		const children = {};   // parent_id → [subject]

		for (const s of subjects) {
			if (s.parent_id === null) {
				if (!topLevel[s.category]) topLevel[s.category] = [];
				topLevel[s.category].push(s);
			} else {
				if (!children[s.parent_id]) children[s.parent_id] = [];
				children[s.parent_id].push(s);
			}
		}

		const categoriesToShow = CATEGORY_ORDER.filter(
			(cat) => topLevel[cat] && topLevel[cat].length > 0,
		);

		for (const cat of categoriesToShow) {
			const tops = topLevel[cat];

			// ── Título de sección ──────────────────────────────────────────
			if (cat === "software") {
				// Header especial con dropdown de ramas
				const headerRow = document.createElement("div");
				headerRow.className = "flex justify-center mt-6 mb-2";

				// Dropdown de ramas
				const RAMAS = [
					{ label: "Software",                 icon: "code" },
					{ label: "Tecnologías de Información", icon: "wifi" },
				];
				const dropWrap = document.createElement("div");
				dropWrap.className = "rama-drop-wrap";

				const trigger = document.createElement("button");
				trigger.type = "button";
				trigger.className = "rama-drop-trigger";
				trigger.innerHTML = `<span class="material-icons rama-drop-icon" aria-hidden="true">code</span><span class="rama-drop-label">Software</span><span class="material-icons rama-drop-chev" aria-hidden="true">expand_more</span>`;
				dropWrap.appendChild(trigger);

				const menu = document.createElement("div");
				menu.className = "rama-drop-menu hidden";
				for (const rama of RAMAS) {
					const item = document.createElement("button");
					item.type = "button";
					item.dataset.icon  = rama.icon;
					item.dataset.label = rama.label;
					item.className = "rama-drop-item" + (rama.label === "Software" ? " is-active" : "");
					item.innerHTML = `<span class="material-icons rama-item-icon" aria-hidden="true">${rama.icon}</span><span>${rama.label}</span>`;
					menu.appendChild(item);
				}
				dropWrap.appendChild(menu);
				headerRow.appendChild(dropWrap);
				container.appendChild(headerRow);

				// Wrapper para los subjects de Software (visible por defecto)
				const subjectsWrap = document.createElement("div");
				subjectsWrap.id = "software-subjects-wrap";

				// Wrapper para los subjects de Tecnologías de la Información (oculto por defecto)
				const tiWrap = document.createElement("div");
				tiWrap.id = "ti-subjects-wrap";
				tiWrap.className = "hidden";

				// Placeholder "Próximamente" para ramas sin contenido (oculto por defecto)
				const placeholder = document.createElement("div");
				placeholder.id = "software-placeholder";
				placeholder.className = "hidden rama-placeholder";

				// ── Lógica del dropdown ────────────────────────────
				trigger.addEventListener("click", function (e) {
					e.stopPropagation();
					menu.classList.toggle("hidden");
					trigger.classList.toggle("is-open", !menu.classList.contains("hidden"));
				});
				document.addEventListener("click", function () {
					menu.classList.add("hidden");
					trigger.classList.remove("is-open");
				});
				menu.addEventListener("click", function (e) {
					const item = e.target.closest(".rama-drop-item");
					if (!item) return;
					const labelText = item.dataset.label;
					const iconText  = item.dataset.icon;
					trigger.querySelector(".rama-drop-label").textContent = labelText;
					trigger.querySelector(".rama-drop-icon").textContent = iconText;
					const selected = labelText;
					menu.querySelectorAll(".rama-drop-item").forEach((i) => i.classList.remove("is-active"));
					item.classList.add("is-active");
					menu.classList.add("hidden");
					trigger.classList.remove("is-open");

					if (selected === "Software") {
						subjectsWrap.classList.remove("hidden");
						tiWrap.classList.add("hidden");
						placeholder.classList.add("hidden");
					} else if (selected === "Tecnologías de Información") {
						subjectsWrap.classList.add("hidden");
						tiWrap.classList.remove("hidden");
						placeholder.classList.add("hidden");
					} else {
						subjectsWrap.classList.add("hidden");
						tiWrap.classList.add("hidden");
						placeholder.classList.remove("hidden");
						placeholder.innerHTML = `
							<div class="rama-placeholder-inner">
								<span class="material-icons">construction</span>
								<p class="rama-placeholder-title">${selected}</p>
								<p class="rama-placeholder-sub">Próximamente</p>
							</div>`;
					}
				});

				// Render subjects de Software dentro de su wrapper
				renderCategoryGrid(tops, children, subjectsWrap);
				container.appendChild(subjectsWrap);

				// Render subjects de Tecnologías de la Información dentro de su wrapper
				const tiTops = topLevel["ti"] || [];
				if (tiTops.length > 0) {
					renderCategoryGrid(tiTops, children, tiWrap);
				}
				container.appendChild(tiWrap);
				container.appendChild(placeholder);

			} else {
				const h3 = document.createElement("h3");
				h3.className = "text-[0.78rem] font-heading font-bold mt-8 mb-4 tracking-[0.12em] uppercase text-text-muted";
				h3.textContent = CATEGORY_LABELS[cat] || cat;
				container.appendChild(h3);
				renderCategoryGrid(tops, children, container);
			}
		}

		// Delegar clics en el contenedor
		container.addEventListener("click", function (e) {
			const btn = e.target.closest("button");
			if (!btn) return;
			const sublistId = btn.id + "-sublist";
			const sublist = document.getElementById(sublistId);
			if (sublist) {
				const isOpen = !sublist.classList.contains("hidden");
				container.querySelectorAll('[id$="-sublist"]').forEach((sl) => {
					if (sl.id !== sublistId) {
						sl.classList.add("hidden");
						sl.classList.remove("sublist-open");
					}
				});
				container.querySelectorAll("button.subject-open").forEach((b) => {
					if (b !== btn) b.classList.remove("subject-open");
				});
				if (isOpen) {
					sublist.classList.remove("sublist-open");
					sublist.classList.add("hidden");
					btn.classList.remove("subject-open");
				} else {
					sublist.classList.remove("hidden");
					btn.classList.add("subject-open");
					requestAnimationFrame(() => requestAnimationFrame(() => sublist.classList.add("sublist-open")));
				}
			}
			// Si no tiene sublist, la navegación ya está en el listener del btn
		});
	}

	/** Badge "No oficial · IA" reutilizable con tooltip. */
	function makeAiBadge() {
		const badge = document.createElement("span");
		badge.className = "ai-badge";
		badge.setAttribute("aria-label", "Preguntas generadas con IA, no provienen de exámenes reales");
		badge.innerHTML = `<span class="material-icons ai-badge-icon" aria-hidden="true">auto_awesome</span>IA`;
		return badge;
	}

	/** Crea el botón raíz: si tiene hijos, abre sublist; si no, navega. */
	function makeTopBtn(subject, children) {
		const kids = children[subject.id] || [];
		const hasSynth = !!SYNTHETIC_FULL[subject.id];
		const hasSections = !!SECTION_BUTTONS[subject.id];
		const hasChildren = kids.length > 0 || hasSynth || hasSections;

		const btn = document.createElement("button");
		btn.id = subject.id;
		btn.className = "btn" + (NEW_SUBJECTS.has(subject.id) ? " btn--new" : "");

		if (NEW_SUBJECTS.has(subject.id)) {
			if (subject.is_ai_generated) btn.className += " btn--ai";
			const nameSpan = document.createElement("span");
			nameSpan.textContent = subject.display_name;
			btn.appendChild(nameSpan);
			const newBadge = document.createElement("span");
			newBadge.className = "new-badge";
			newBadge.textContent = "Nuevo";
			btn.appendChild(newBadge);
			if (subject.is_ai_generated) btn.appendChild(makeAiBadge());
		} else if (DEPRECATED_SUBJECTS.has(subject.id)) {
			btn.className += " btn--deprecated";
			const nameSpan = document.createElement("span");
			nameSpan.textContent = subject.display_name;
			const badge = document.createElement("span");
			badge.className = "deprecated-badge";
			badge.title = "Esta asignatura ya no se imparte o ha sido reemplazada";
			badge.textContent = "Antiguo";
			btn.appendChild(nameSpan);
			btn.appendChild(badge);
		} else if (subject.is_ai_generated) {
			btn.className += " btn--ai";
			const nameSpan = document.createElement("span");
			nameSpan.textContent = subject.display_name;
			btn.appendChild(nameSpan);
			btn.appendChild(makeAiBadge());
		} else {
			btn.textContent = subject.display_name;
		}

		if (hasChildren) {
			const chev = document.createElement("span");
			chev.className = "material-icons subject-chevron";
			chev.setAttribute("aria-hidden", "true");
			chev.textContent = "expand_more";
			btn.appendChild(chev);
		} else {
			btn.addEventListener("click", () => { window.location.href = `/${subject.id}`; });
		}

		return btn;
	}

	// ─── Buscador ────────────────────────────────────────────────────────────

	const norm = (s) => String(s).normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();

	/** Índice plano de todo lo "abrible": exámenes/módulos con su asignatura. */
	function buildSearchIndex(subjects) {
		const byId = new Map(subjects.map((s) => [s.id, s]));
		const kids = {};
		for (const s of subjects) {
			if (s.parent_id) (kids[s.parent_id] = kids[s.parent_id] || []).push(s);
		}
		const out = [];
		const add = (label, group, href) =>
			out.push({ label, group, href, hay: norm(`${label} ${group}`) });

		for (const s of subjects) {
			if (HIDDEN_SUBJECTS.has(s.id)) continue;
			if (s.parent_id) {
				const parent = byId.get(s.parent_id);
				add(s.display_name, parent ? parent.display_name : "", `/${s.id}`);
				continue;
			}
			const children = (kids[s.id] || []).filter((c) => !HIDDEN_SUBJECTS.has(c.id));
			const synth = SYNTHETIC_FULL[s.id];
			const sections = SECTION_BUTTONS[s.id];
			if (!children.length && !synth && !sections) {
				add(s.display_name, CATEGORY_LABELS[s.category] || "", `/${s.id}`);
				continue;
			}
			if (synth) add(synth.display_name, s.display_name, `/${synth.id}`);
			for (const sec of sections || []) {
				add(sec.label, s.display_name, `/${s.id}?src=${encodeURIComponent(sec.src)}`);
			}
		}
		return out;
	}

	function initSearch(index) {
		const input     = document.getElementById("subject-search");
		const results   = document.getElementById("search-results");
		const container = document.getElementById("asignaturas-container");
		if (!input || !results || !container) return;

		const esc = window.Utils.esc;
		let matches = [];
		let active  = 0;

		function paintActive() {
			results.querySelectorAll(".search-item").forEach((el, i) => {
				const on = i === active;
				el.classList.toggle("is-active", on);
				el.setAttribute("aria-selected", on ? "true" : "false");
				if (on) el.scrollIntoView({ block: "nearest" });
			});
		}

		function render() {
			const raw = input.value.trim();
			if (!raw) {
				results.classList.add("hidden");
				results.innerHTML = "";
				container.classList.remove("hidden");
				return;
			}
			const terms = norm(raw).split(/\s+/);
			matches = index.filter((e) => terms.every((t) => e.hay.includes(t))).slice(0, 30);
			active = 0;
			container.classList.add("hidden");
			results.classList.remove("hidden");
			if (matches.length === 0) {
				results.innerHTML = `<p class="search-empty">Sin resultados para «${esc(raw)}»</p>`;
				return;
			}
			results.innerHTML = matches.map((m, i) =>
				`<a role="option" href="${esc(m.href)}" class="search-item" aria-selected="${i === 0}">` +
					`<span class="search-item-label">${esc(m.label)}</span>` +
					(m.group ? `<span class="search-item-group">${esc(m.group)}</span>` : "") +
					`<span class="material-icons search-item-arrow" aria-hidden="true">arrow_forward</span>` +
				`</a>`
			).join("");
			paintActive();
		}

		input.addEventListener("input", render);
		input.addEventListener("keydown", (e) => {
			if (e.key === "ArrowDown" && matches.length) {
				e.preventDefault();
				active = (active + 1) % matches.length;
				paintActive();
			} else if (e.key === "ArrowUp" && matches.length) {
				e.preventDefault();
				active = (active - 1 + matches.length) % matches.length;
				paintActive();
			} else if (e.key === "Enter" && matches[active]) {
				e.preventDefault();
				window.location.href = matches[active].href;
			} else if (e.key === "Escape") {
				input.value = "";
				render();
				input.blur();
			}
		});

		// Atajo global "/" para enfocar el buscador
		document.addEventListener("keydown", (e) => {
			if (e.key !== "/" || e.ctrlKey || e.metaKey || e.altKey) return;
			const t = e.target;
			if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
			e.preventDefault();
			input.focus();
			input.select();
		});
	}

	// ─── Continuar donde lo dejaste ──────────────────────────────────────────

	function initContinue(subjects) {
		const card = document.getElementById("continue-card");
		if (!card) return;

		async function run() {
			const db  = window.SupabaseClient;
			const uid = window.Utils?.userId();
			if (!db || !uid) return;

			const { data, error } = await db
				.from("test_progress")
				.select("quiz_key, current_index, answered_count, question_ids")
				.eq("user_id", uid)
				.order("updated_at", { ascending: false })
				.limit(1)
				.maybeSingle();
			if (error || !data) return;

			const total = Array.isArray(data.question_ids) ? data.question_ids.length : 0;
			if (!total || data.answered_count >= total) return;

			const subj  = subjects.find((s) => s.id === data.quiz_key);
			const synth = Object.values(SYNTHETIC_FULL).find((s) => s.id === data.quiz_key);
			const name  = subj ? subj.display_name : synth ? synth.display_name : data.quiz_key.toUpperCase();
			const pct   = Math.round((data.answered_count / total) * 100);

			card.href = `/${data.quiz_key}`;
			document.getElementById("continue-card-title").textContent = name;
			document.getElementById("continue-card-meta").textContent =
				`Pregunta ${Math.min(data.current_index + 1, total)} de ${total} · ${pct}% completado`;
			card.classList.remove("hidden");
		}

		if (window.Auth && typeof window.Auth.onReady === "function") window.Auth.onReady(run);
		else run();
	}

	// ─── Carga de datos ──────────────────────────────────────────────────────

	async function loadSubjects() {
		const loading   = document.getElementById("subjects-loading");
		const container = document.getElementById("asignaturas-container");

		const db = window.SupabaseClient;
		if (!db) {
			if (loading) loading.innerHTML = '<p class="text-text-muted text-sm">No se pudo conectar con la base de datos.</p>';
			return;
		}

		try {
			const { data, error } = await db
				.from("subjects")
				.select("id, display_name, category, parent_id, sort_order, semester, is_ai_generated")
				.order("sort_order", { ascending: true });

			if (error) throw error;

			if (loading)   loading.classList.add("hidden");
			if (container) container.classList.remove("hidden");

			renderSubjects(data || []);
			initSearch(buildSearchIndex(data || []));
			initContinue(data || []);
		} catch (err) {
			console.error("[Index] Error cargando asignaturas:", err);
			if (loading) loading.innerHTML = '<p class="text-text-muted text-sm">Error al cargar las asignaturas. Recarga la página.</p>';
		}
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", loadSubjects);
	} else {
		loadSubjects();
	}
})();
</script>
</BaseLayout>

